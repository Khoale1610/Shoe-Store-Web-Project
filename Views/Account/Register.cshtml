@model RegisterViewModel
@{
    ViewData["Title"] = "ĐĂNG KÝ TÀI KHOẢN";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7">
                <div class="border bg-white p-4 p-md-5">
                    <div class="mb-4 pb-3 border-bottom">
                        <h3 class="sb-section-title mb-1">ĐĂNG KÝ THÀNH VIÊN MỚI</h3>
                        <p class="text-muted small mb-0">Nhận ngay ưu đãi giảm 10% với mã <strong>WELCOME10</strong> cho đơn hàng đầu tiên</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-0 small">
                            <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                        </div>
                    }

                    <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="HoTen" class="form-label small fw-bold text-uppercase">HỌ VÀ TÊN *</label>
                                <input asp-for="HoTen" class="form-control rounded-0" placeholder="VD: Nguyễn Văn An" />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label small fw-bold text-uppercase">SỐ ĐIỆN THOẠI *</label>
                                <input asp-for="SoDienThoai" class="form-control rounded-0" placeholder="VD: 0912345678" />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label small fw-bold text-uppercase">ĐỊA CHỈ EMAIL *</label>
                                <input asp-for="Email" class="form-control rounded-0" placeholder="VD: nguyenvanan@gmail.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MatKhau" class="form-label small fw-bold text-uppercase">MẬT KHẨU (TỐI THIỂU 6 KÝ TỰ) *</label>
                                <input asp-for="MatKhau" class="form-control rounded-0" placeholder="Nhập mật khẩu" />
                                <span asp-validation-for="MatKhau" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="XacNhanMatKhau" class="form-label small fw-bold text-uppercase">XÁC NHẬN MẬT KHẨU *</label>
                                <input asp-for="XacNhanMatKhau" class="form-control rounded-0" placeholder="Nhập lại mật khẩu" />
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DiaChi" class="form-label small fw-bold text-uppercase">ĐỊA CHỈ GIAO HÀNG MẶC ĐỊNH *</label>
                                <input asp-for="DiaChi" class="form-control rounded-0" placeholder="Số nhà, đường, Phường/Xã, Quận/Huyện, Tỉnh/TP" />
                                <span asp-validation-for="DiaChi" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="sb-btn sb-btn-red w-100 mt-4">
                            HOÀN TẤT ĐĂNG KÝ
                        </button>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top small">
                        Đã có tài khoản?
                        <a asp-controller="Account" asp-action="Login" class="text-dark fw-bold text-decoration-underline ms-1">
                            ĐĂNG NHẬP NGAY
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
