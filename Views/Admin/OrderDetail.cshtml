@model HoaDon
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"CHI TIẾT ĐƠN HÀNG #{Model.MaHoaDon}";
    decimal tamTinh = Model.ChiTietHoaDons.Sum(c => c.SoLuong * c.DonGia);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div class="d-flex align-items-center gap-2">
        <span class="adm-badge @(Model.TrangThai == "Hoàn thành" ? "adm-badge-black" : Model.TrangThai == "Đã hủy" ? "adm-badge-gray" : "adm-badge-red")">
            TRẠNG THÁI: @Model.TrangThai.ToUpper()
        </span>
        <span class="adm-section-title">HÓA ĐƠN #@Model.MaHoaDon — NGÀY LẬP: @Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</span>
    </div>
    <a asp-controller="Admin" asp-action="Orders" class="adm-btn adm-btn-outline adm-btn-sm">
        ← QUAY LẠI DANH SÁCH ĐƠN
    </a>
</div>

<div class="row g-3">
    <!-- Cột Trái: Danh sách sản phẩm trong đơn -->
    <div class="col-lg-8">
        <div class="adm-panel">
            <div class="adm-panel-head">
                <h2 class="adm-panel-title mb-0">DANH SÁCH GIÀY KHÁCH ĐẶT MUA (@Model.ChiTietHoaDons.Sum(c => c.SoLuong) ĐÔI)</h2>
            </div>
            <div class="table-responsive">
                <table class="table adm-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>SẢN PHẨM</th>
                            <th class="text-center">MÀU SẮC</th>
                            <th class="text-center">KÍCH CỠ</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">ĐƠN GIÁ</th>
                            <th class="text-end">THÀNH TIỀN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in Model.ChiTietHoaDons)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(ct.BienTheSanPham?.SanPham?.HinhAnh)"
                                             alt="@(ct.BienTheSanPham?.SanPham?.TenSanPham)"
                                             class="adm-thumb-50" />
                                        <div>
                                            <div class="fw-bold text-dark">@(ct.BienTheSanPham?.SanPham?.TenSanPham)</div>
                                            <div class="small text-muted">SKU: @(ct.BienTheSanPham?.MaSKU)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="d-inline-flex align-items-center gap-1 small fw-semibold">
                                        <span class="color-dot" style="background-color: @(ct.BienTheSanPham?.MauSac?.MaHex ?? "#111111");"></span>
                                        @(ct.BienTheSanPham?.MauSac?.TenMau)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="adm-badge adm-badge-black">SIZE @(ct.BienTheSanPham?.KichCo?.SoKichCo)</span>
                                </td>
                                <td class="text-center fw-bold">x@ct.SoLuong</td>
                                <td class="text-end">@ct.DonGia.ToString("N0")₫</td>
                                <td class="text-end fw-extrabold text-dark">@((ct.SoLuong * ct.DonGia).ToString("N0"))₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light-gray">
                        <tr>
                            <td colspan="5" class="text-end fw-bold text-uppercase small">TẠM TÍNH:</td>
                            <td class="text-end fw-bold">@tamTinh.ToString("N0")₫</td>
                        </tr>
                        @if (Model.TienGiam > 0)
                        {
                            <tr>
                                <td colspan="5" class="text-end fw-bold text-uppercase small text-sale">
                                    GIẢM GIÁ KHUYẾN MÃI @(Model.KhuyenMai != null ? $"({Model.KhuyenMai.MaCode} - {Model.KhuyenMai.PhanTramGiam}%)" : ""):
                                </td>
                                <td class="text-end text-sale fw-bold">-@Model.TienGiam.ToString("N0")₫</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="5" class="text-end fw-extrabold text-uppercase">TỔNG TIỀN THANH TOÁN:</td>
                            <td class="text-end fw-black fs-5 text-sale">@Model.TongTien.ToString("N0")₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Cột Phải: Thông tin khách nhận & Cập nhật trạng thái -->
    <div class="col-lg-4">
        <div class="adm-panel mb-3">
            <div class="adm-panel-head">
                <h2 class="adm-panel-title mb-0">THÔNG TIN GIAO HÀNG</h2>
            </div>
            <div class="p-4">
                <div class="mb-2">
                    <span class="adm-label d-block">NGƯỜI NHẬN HÀNG:</span>
                    <strong class="text-dark">@Model.TenNguoiNhan</strong>
                </div>
                <div class="mb-2">
                    <span class="adm-label d-block">SỐ ĐIỆN THOẠI:</span>
                    <strong class="text-dark">@Model.SDTNguoiNhan</strong>
                </div>
                <div class="mb-2">
                    <span class="adm-label d-block">ĐỊA CHỈ NHẬN HÀNG:</span>
                    <strong class="text-dark">@Model.DiaChiGiaoHang</strong>
                </div>
                <div class="mb-2">
                    <span class="adm-label d-block">PHƯƠNG THỨC THANH TOÁN:</span>
                    <span class="adm-badge adm-badge-outline">@Model.PhuongThucThanhToan.ToUpper()</span>
                </div>
                @if (Model.QuanTriVien != null)
                {
                    <div class="mt-3 pt-2 border-top small text-muted">
                        Nhân viên duyệt gần nhất: <strong>@Model.QuanTriVien.HoTen</strong>
                    </div>
                }
            </div>
        </div>

        <div class="adm-panel">
            <div class="adm-panel-head">
                <h2 class="adm-panel-title mb-0">DUYỆT & CẬP NHẬT TRẠNG THÁI</h2>
            </div>
            <div class="p-4">
                <form asp-controller="Admin" asp-action="UpdateOrderStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maHoaDon" value="@Model.MaHoaDon" />
                    <input type="hidden" name="returnToDetail" value="true" />

                    <div class="mb-3">
                        <label class="adm-label">CHỌN TRẠNG THÁI XỬ LÝ MỚI:</label>
                        <select name="trangThaiMoi" class="adm-select fw-bold">
                            <option value="Chờ xác nhận" selected="@(Model.TrangThai == "Chờ xác nhận")">1. CHỜ XÁC NHẬN</option>
                            <option value="Đang giao" selected="@(Model.TrangThai == "Đang giao")">2. ĐANG GIAO HÀNG</option>
                            <option value="Hoàn thành" selected="@(Model.TrangThai == "Hoàn thành")">3. HOÀN THÀNH ĐƠN HÀNG</option>
                            <option value="Đã hủy" selected="@(Model.TrangThai == "Đã hủy")">4. HỦY ĐƠN HÀNG (HOÀN KHO)</option>
                        </select>
                    </div>

                    <button type="submit" class="adm-btn adm-btn-red w-100">
                        <i class="bi bi-check2 me-2"></i>CẬP NHẬT TRẠNG THÁI
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
