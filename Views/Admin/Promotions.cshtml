@model List<KhuyenMai>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "QUẢN LÝ MÃ KHUYẾN MÃI";
    var now = DateTime.Now;
}

<div class="adm-toolbar d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <div class="adm-section-title">DANH SÁCH MÃ GIẢM GIÁ (@Model.Count CHƯƠNG TRÌNH)</div>
        <div class="adm-section-sub">Mã giảm giá kích hoạt sẽ liên kết và cho phép áp dụng trực tiếp tại trang Giỏ hàng của khách</div>
    </div>
    <a asp-controller="Admin" asp-action="CreatePromotion" class="adm-btn adm-btn-red">
        <i class="bi bi-plus-lg me-2"></i>TẠO MÃ GIẢM GIÁ MỚI
    </a>
</div>

<div class="adm-panel">
    <div class="table-responsive">
        <table class="table adm-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;">MÃ KM</th>
                    <th>MÃ CODE</th>
                    <th>TÊN CHƯƠNG TRÌNH KHUYẾN MÃI</th>
                    <th class="text-center">MỨC GIẢM</th>
                    <th>THỜI HẠN ÁP DỤNG</th>
                    <th class="text-center">TRẠNG THÁI</th>
                    <th class="text-center">LƯỢT DÙNG</th>
                    <th class="text-end" style="width: 180px;">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var km in Model)
                {
                    bool isValidDate = now >= km.NgayBatDau && now <= km.NgayKetThuc;
                    bool isActive = km.TrangThai && isValidDate;

                    <tr>
                        <td class="fw-extrabold">#@km.MaKM</td>
                        <td>
                            <span class="adm-badge adm-badge-black font-monospace fs-6">@km.MaCode</span>
                        </td>
                        <td class="fw-bold text-dark">@km.TenChuongTrinh</td>
                        <td class="text-center">
                            <span class="adm-badge adm-badge-red">- @km.PhanTramGiam%</span>
                        </td>
                        <td class="small text-secondary">
                            <div>Từ: <strong>@km.NgayBatDau.ToString("dd/MM/yyyy")</strong></div>
                            <div>Đến: <strong>@km.NgayKetThuc.ToString("dd/MM/yyyy")</strong></div>
                        </td>
                        <td class="text-center">
                            @if (isActive)
                            {
                                <span class="adm-badge adm-badge-black">ĐANG HOẠT ĐỘNG</span>
                            }
                            else if (!km.TrangThai)
                            {
                                <span class="adm-badge adm-badge-gray">ĐÃ TẮT</span>
                            }
                            else
                            {
                                <span class="adm-badge adm-badge-red">HẾT HẠN</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="adm-badge adm-badge-gray">@(km.HoaDons?.Count ?? 0) ĐƠN</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-controller="Admin" asp-action="EditPromotion" asp-route-id="@km.MaKM"
                                   class="adm-action-btn adm-action-edit">
                                    <i class="bi bi-pencil-square"></i> SỬA
                                </a>

                                <form asp-controller="Admin" asp-action="DeletePromotion" asp-route-id="@km.MaKM" method="post"
                                      onsubmit="return confirm('Xác nhận xóa mã khuyến mãi [@km.MaCode]?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="adm-action-btn adm-action-delete">
                                        <i class="bi bi-trash3"></i> XÓA
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
