@model HoaDon
@{
    ViewData["Title"] = $"ĐẶT HÀNG THÀNH CÔNG #{Model.MaHoaDon}";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="border bg-white p-4 p-lg-5">
                    <div class="text-center pb-4 mb-4 border-bottom">
                        <span class="sb-badge-new d-inline-block mb-2">ORDER CONFIRMED</span>
                        <h2 class="fw-black text-uppercase mb-1">ĐẶT HÀNG THÀNH CÔNG!</h2>
                        <p class="text-muted small mb-0">
                            Mã đơn hàng: <strong class="text-sale">#@Model.MaHoaDon</strong> — Ngày lập: @Model.NgayLap.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light-gray border h-100 small">
                                <div class="fw-bold text-uppercase mb-2">THÔNG TIN NGƯỜI NHẬN</div>
                                <div class="fw-bold">@Model.TenNguoiNhan</div>
                                <div>SĐT: @Model.SDTNguoiNhan</div>
                                <div>Địa chỉ: @Model.DiaChiGiaoHang</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light-gray border h-100 small">
                                <div class="fw-bold text-uppercase mb-2">THANH TOÁN & TRẠNG THÁI</div>
                                <div>Phương thức: <strong>@Model.PhuongThucThanhToan</strong></div>
                                <div>Trạng thái: <strong class="text-sale">@Model.TrangThai</strong></div>
                                @if (Model.KhuyenMai != null)
                                {
                                    <div>Mã giảm giá: <strong>@Model.KhuyenMai.MaCode (-@Model.KhuyenMai.PhanTramGiam%)</strong></div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle small mb-0">
                            <thead class="bg-light-gray text-uppercase">
                                <tr>
                                    <th>SẢN PHẨM</th>
                                    <th class="text-center">PHÂN LOẠI</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">ĐƠN GIÁ</th>
                                    <th class="text-end">THÀNH TIỀN</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in Model.ChiTietHoaDons)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@(ct.BienTheSanPham?.SanPham?.TenSanPham)</div>
                                            <span class="text-muted">SKU: @(ct.BienTheSanPham?.MaSKU)</span>
                                        </td>
                                        <td class="text-center">Màu @(ct.BienTheSanPham?.MauSac?.TenMau) | Size @(ct.BienTheSanPham?.KichCo?.SoKichCo)</td>
                                        <td class="text-center fw-bold">x@ct.SoLuong</td>
                                        <td class="text-end">@ct.DonGia.ToString("N0")₫</td>
                                        <td class="text-end fw-bold">@((ct.SoLuong * ct.DonGia).ToString("N0"))₫</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                @if (Model.TienGiam > 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-end fw-bold text-sale">GIẢM GIÁ KHUYẾN MÃI:</td>
                                        <td class="text-end fw-bold text-sale">-@Model.TienGiam.ToString("N0")₫</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="4" class="text-end fw-extrabold text-uppercase">TỔNG THANH TOÁN:</td>
                                    <td class="text-end fw-black fs-5 text-sale">@Model.TongTien.ToString("N0")₫</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a asp-controller="Product" asp-action="Index" class="sb-btn sb-btn-black px-4">
                            TIẾP TỤC MUA SẮM
                        </a>
                        <a asp-controller="Account" asp-action="Orders" class="sb-btn sb-btn-red px-4">
                            XEM LỊCH SỬ ĐƠN HÀNG
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
