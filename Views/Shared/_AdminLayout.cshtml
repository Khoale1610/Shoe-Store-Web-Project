@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    string adminName = session?.GetString("AdminName") ?? "Quản Trị Viên";
    string adminUsername = session?.GetString("AdminUsername") ?? "admin";
    string userRole = session?.GetString("UserRole") ?? "SuperAdmin";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ADMIN DASHBOARD | STRIDELAB RETAIL</title>
    <!-- Google Fonts: Montserrat, Oswald & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&family=Oswald:wght@600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="adm-body">
    <div class="adm-wrapper d-flex min-vh-100">
        <!-- SIDEBAR BÊN TRÁI (Nền đen tuyền #111111, góc vuông sắc nét) -->
        <aside class="adm-sidebar d-flex flex-column flex-shrink-0" id="adminSidebar">
            <!-- Brand Header -->
            <div class="adm-sidebar-brand d-flex align-items-center justify-content-between">
                <a asp-controller="Admin" asp-action="Index" class="text-decoration-none d-flex align-items-center gap-2">
                    <span class="adm-logo-box">S</span>
                    <div>
                        <span class="adm-brand-title">STRIDE<span class="text-sale">LAB</span></span>
                        <span class="adm-brand-sub d-block">ADMIN RETAIL SYSTEM</span>
                    </div>
                </a>
                <button class="adm-icon-btn d-lg-none" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Thông tin tài khoản Quản trị -->
            <div class="adm-user-panel d-flex align-items-center gap-3">
                <div class="adm-user-avatar">
                    @adminName.Substring(0, 1).ToUpper()
                </div>
                <div class="overflow-hidden">
                    <div class="adm-user-name text-truncate">@adminName</div>
                    <div class="adm-user-role">ROLE: ADMIN (@userRole.ToUpper())</div>
                </div>
            </div>

            <!-- Menu Điều hướng 5 Phân hệ -->
            <div class="adm-nav-section flex-grow-1">
                <div class="adm-nav-heading">DANH MỤC QUẢN LÝ</div>
                <ul class="list-unstyled mb-0 adm-nav-list">
                    <li>
                        <a asp-controller="Admin" asp-action="Index"
                           class="adm-nav-link @(currentAction == "Index" || currentAction == "Revenue" ? "active" : "")">
                            <i class="bi bi-bar-chart-fill"></i>
                            <span>THỐNG KÊ & DOANH THU</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Categories"
                           class="adm-nav-link @(currentAction.Contains("Category") || currentAction == "Categories" ? "active" : "")">
                            <i class="bi bi-diagram-3-fill"></i>
                            <span>1. LOẠI SẢN PHẨM</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Products"
                           class="adm-nav-link @(currentAction.Contains("Product") ? "active" : "")">
                            <i class="bi bi-box-seam-fill"></i>
                            <span>2. QUẢN LÝ SẢN PHẨM</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Orders"
                           class="adm-nav-link @(currentAction.Contains("Order") ? "active" : "")">
                            <i class="bi bi-receipt"></i>
                            <span>3. QUẢN LÝ ĐƠN HÀNG</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Admin" asp-action="Promotions"
                           class="adm-nav-link @(currentAction.Contains("Promotion") ? "active" : "")">
                            <i class="bi bi-ticket-perforated-fill"></i>
                            <span>4. MÃ KHUYẾN MÃI</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Chân Sidebar (Nút vuông sắc nét) -->
            <div class="adm-sidebar-footer">
                <a asp-controller="Home" asp-action="Index" class="adm-btn adm-btn-outline-light w-100 mb-2">
                    <i class="bi bi-shop me-2"></i>TRANG KHÁCH HÀNG
                </a>
                <a asp-controller="Account" asp-action="Logout" class="adm-btn adm-btn-red w-100">
                    <i class="bi bi-box-arrow-right me-2"></i>ĐĂNG XUẤT (@adminUsername.ToUpper())
                </a>
            </div>
        </aside>

        <!-- NỘI DUNG BÊN PHẢI (Nền #F4F4F5, Khung bảng #FFFFFF viền mảnh #E4E4E7) -->
        <div class="adm-main flex-grow-1 d-flex flex-column min-w-0">
            <!-- Topbar bên phải -->
            <header class="adm-topbar d-flex align-items-center justify-content-between sticky-top">
                <div class="d-flex align-items-center gap-3">
                    <button class="adm-btn adm-btn-outline d-lg-none px-3" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div>
                        <h1 class="adm-page-title mb-0">@ViewData["Title"]</h1>
                        <div class="adm-page-subtitle">STRIDELAB / SNEAKER BUZZ — QUẢN TRỊ HỆ THỐNG CỬA HÀNG GIÀY</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Admin" asp-action="CreateProduct" class="adm-btn adm-btn-black d-none d-sm-inline-flex">
                        <i class="bi bi-plus-lg me-1"></i>THÊM SẢN PHẨM
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="adm-btn adm-btn-outline">
                        <i class="bi bi-box-arrow-up-right me-1"></i>XEM STOREFRONT
                    </a>
                </div>
            </header>

            <!-- Nội dung chính -->
            <main class="p-4 flex-grow-1">
                @RenderBody()
            </main>

            <footer class="adm-footer d-flex flex-wrap justify-content-between align-items-center px-4 py-3">
                <div>© @DateTime.Now.Year <strong>STRIDELAB ADMIN DASHBOARD</strong> — SQL SERVER QL_SHOPGIAY</div>
                <div>PHÂN QUYỀN BẢO MẬT: <strong class="text-sale">ROLE = 'ADMIN'</strong></div>
            </footer>
        </div>
    </div>

    <!-- Toast thông báo vuông vức -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
        <div id="liveToast" class="toast sb-toast border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center gap-2">
                    <i id="liveToastIcon" class="bi bi-check-square-fill text-white"></i>
                    <span id="liveToastMessage" class="fw-semibold small text-white">Thao tác thành công!</span>
                </div>
                <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    @if (TempData["ToastSuccess"] != null)
    {
        <div data-server-toast="@TempData["ToastSuccess"]" data-server-toast-type="success" class="d-none"></div>
    }
    @if (TempData["ToastWarning"] != null)
    {
        <div data-server-toast="@TempData["ToastWarning"]" data-server-toast-type="warning" class="d-none"></div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
